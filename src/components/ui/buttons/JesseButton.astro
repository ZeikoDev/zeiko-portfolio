---
const {
    showText = false,
    size = "default",
    variant = "icon",
    href,
    target,
    rel,
    class: className,
} = Astro.props;
---

{
    href ? (
        <a
            href={href}
            target={target}
            rel={rel}
            class:list={[`jesse-btn ${variant} ${size}`, className]}
            tabindex='0'
        >
            <slot name='icon' />
            {showText ? (
                <span class='jesse-btn-text'>
                    <slot />
                </span>
            ) : null}
        </a>
    ) : (
        <button
            class:list={[`jesse-btn ${variant} ${size}`, className]}
            type='button'
        >
            <slot name='icon' />
            {showText ? (
                <span class='jesse-btn-text'>
                    <slot />
                </span>
            ) : null}
        </button>
    )
}

<style>
    .jesse-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: transparent;
        color: #2E8BFF;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 600;
        letter-spacing: 0.05em;
        border: 1px solid rgba(46, 139, 255, 0.25);
        border-radius: 2rem;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        cursor: pointer;
        text-decoration: none;
    }

    .jesse-btn:hover {
        background: #2E8BFF;
        color: #060d18;
        border-color: #2E8BFF;
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(46, 139, 255, 0.25);
    }

    .jesse-btn:active {
        transform: translateY(0) scale(0.97);
        box-shadow: none;
    }

    .jesse-btn:focus-visible {
        outline: 2px solid #2E8BFF;
        outline-offset: 2px;
    }

    .jesse-btn.icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        padding: 0;
    }

    .jesse-btn.text {
        width: auto;
        min-width: auto;
        padding: 0.5rem 1.25rem;
    }

    .jesse-btn.small {
        font-size: 0.8rem;
        padding: 0.4rem 1rem;
    }

    .jesse-btn.large {
        font-size: 1rem;
        padding: 0.65rem 1.75rem;
    }

    .jesse-btn-text {
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }
</style>
