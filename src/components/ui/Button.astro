---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "ghost" | "on-blue" | "outline-on-blue";

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
    href?: string;
    variant?: Variant;
    external?: boolean;
    class?: string;
    type?: "button" | "submit";
}

const { href, variant = "primary", external = false, class: className, type = "button", ...rest } = Astro.props;
const classes = ["btn", `btn-${variant}`, className];
---

{
    href ? (
        <a
            href={href}
            class:list={classes}
            {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            {...rest}
        >
            <slot />
        </a>
    ) : (
        <button type={type} class:list={classes} {...(rest as Record<string, unknown>)}>
            <slot />
        </button>
    )
}
