---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { projects } from "@/data/projects";
import { useTranslations } from "@/i18n/utils";

const { lang } = Astro.params;
const L = (lang as "en" | "es") || "en";
const t = useTranslations(L);
---

<section id='work' class='section'>
    <div class='shell'>
        <header class='section-head'>
            <h2 class='t-h2'>{t("projects.title")}</h2>
            <p class='t-lead text-fg-2'>{t("projects.intro")}</p>
        </header>

        <div class='cases'>
            {projects.map((p) => (
                <article class='case'>
                    <div class='case-head'>
                        <p class='case-tag t-small'>{p.tag[L]}</p>
                        <h3 class='t-h3'>{p.name[L]}</h3>
                        <p class='case-stack t-small'>{p.technologies.join(", ")}</p>
                        <div class='case-actions'>
                            {(!p.externalLink || p.hasDetailPage) && (
                                <Button href={`/${L}/proyectos/${p.slug}`} variant='secondary'>
                                    {t("projects.caseStudy")}
                                </Button>
                            )}
                            {p.externalLink && (
                                <Button href={p.externalLink} variant='ghost' external>
                                    {t("projects.viewSite")}
                                    <Icon name='external' />
                                </Button>
                            )}
                        </div>
                    </div>
                    <div class='case-media'>
                        <img
                            src={p.image}
                            alt={`${p.name[L]}, ${p.tag[L]}`}
                            loading='lazy'
                            decoding='async'
                        />
                    </div>
                    <dl class='case-story'>
                        <div>
                            <dt>{t("projects.problem")}</dt>
                            <dd>{p.problem[L]}</dd>
                        </div>
                        <div>
                            <dt>{t("projects.solution")}</dt>
                            <dd>{p.solution[L]}</dd>
                        </div>
                        <div class='is-result'>
                            <dt>{t("projects.result")}</dt>
                            <dd>{p.result[L]}</dd>
                        </div>
                    </dl>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
    .cases { border-top: 1px solid rgb(var(--fg)); }
    .case {
        display: grid;
        gap: 24px;
        padding-block: 40px 48px;
        border-bottom: 1px solid rgb(var(--rule));
    }
    @media (min-width: 1024px) {
        .case {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: 32px;
            row-gap: 40px;
            padding-block: 56px 64px;
        }
        .case-head { grid-column: 1 / span 5; display: flex; flex-direction: column; }
        .case-media { grid-column: 6 / span 7; }
        .case-story { grid-column: 1 / -1; }
    }

    .case-tag {
        color: rgb(var(--blue));
        font-weight: 600;
        margin-bottom: 8px;
    }
    .case-stack {
        margin-top: 12px;
        color: rgb(var(--fg-2));
        max-width: 44ch;
    }
    .case-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
        margin-top: 24px;
    }
    @media (min-width: 1024px) {
        .case-actions { margin-top: auto; padding-top: 32px; }
    }

    .case-media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid rgb(var(--rule));
        background: rgb(var(--surface));
    }
    @media (max-width: 1023px) {
        .case-media { order: -1; }
    }
    .case-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
    }

    .case-story {
        display: grid;
        gap: 24px;
    }
    @media (min-width: 768px) {
        .case-story {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 32px;
        }
    }
    .case-story > div {
        border-top: 1px solid rgb(var(--rule));
        padding-top: 16px;
    }
    .case-story dt {
        font-weight: 600;
        margin-bottom: 8px;
    }
    .case-story dd {
        color: rgb(var(--fg-2));
        font-size: 0.975rem;
        line-height: 1.6;
    }
    .case-story .is-result {
        border-top: 2px solid rgb(var(--blue));
        padding-top: 15px;
    }
    .case-story .is-result dd { color: rgb(var(--fg)); }
</style>
