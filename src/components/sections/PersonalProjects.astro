---
import { personalProjects } from "@/data/personalProjects";
import { useTranslations } from "@/i18n/utils";

const { lang } = Astro.params;
const L = (lang as "en" | "es") || "en";
const t = useTranslations(L);
---

<section id='labs' class='section'>
    <div class='shell'>
        <header class='section-head'>
            <h2 class='t-h2'>{t("labs.title")}</h2>
            <p class='t-lead text-fg-2'>{t("labs.intro")}</p>
        </header>

        <ul class='labs'>
            {personalProjects.map((p) => (
                <li class='lab'>
                    <div class='lab-media'>
                        <img src={p.image} alt='' loading='lazy' decoding='async' />
                    </div>
                    <h3 class='lab-title'>
                        <a href={`/${L}/proyectos/${p.slug}`}>{p.name[L]}</a>
                    </h3>
                    <p class='lab-desc'>{p.description[L]}</p>
                    <p class='lab-stack t-small'>{p.technologies.join(", ")}</p>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .labs {
        display: grid;
        border-top: 1px solid rgb(var(--fg));
    }
    @media (min-width: 640px) {
        .labs { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
    }
    @media (min-width: 1024px) {
        .labs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    .lab {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 24px 0 32px;
        border-bottom: 1px solid rgb(var(--rule));
    }
    .lab-media {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border: 1px solid rgb(var(--rule));
        background: rgb(var(--surface));
        margin-bottom: 20px;
    }
    .lab-media img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
    .lab-title {
        font-weight: 700;
        font-size: 1.15rem;
        line-height: 1.25;
    }
    /* Whole tile is the click target; the visible affordance is the title underline. */
    .lab-title a::after { content: ""; position: absolute; inset: 0; }
    .lab-title a { text-decoration: underline; text-decoration-color: rgb(var(--blue) / 0); text-underline-offset: 0.2em; }
    .lab:hover .lab-title a { text-decoration-color: rgb(var(--blue)); }
    .lab-title a:focus-visible { outline: none; }
    .lab:has(a:focus-visible) { outline: 2px solid rgb(var(--blue)); outline-offset: 4px; }
    .lab-desc { margin-top: 8px; color: rgb(var(--fg-2)); flex: 1; }
    .lab-stack { margin-top: 16px; color: rgb(var(--fg-2)); }
</style>
