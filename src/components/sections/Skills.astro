---
import { useTranslations } from "@/i18n/utils";
import type { TranslationKey } from "@/i18n/types";

const { lang } = Astro.params;
const t = useTranslations((lang as "en" | "es") || "en");

const rows: { area: TranslationKey; tools: string[] }[] = [
    { area: "skills.categories.frontend", tools: ["React", "TypeScript", "JavaScript", "Astro", "TailwindCSS", "HTML & CSS"] },
    { area: "skills.categories.mobile", tools: ["React Native", "iOS SDK integration"] },
    { area: "skills.categories.backend", tools: ["Node.js", "Python", "Django", "REST APIs"] },
    { area: "skills.categories.data", tools: ["PostgreSQL", "Firebase Auth", "Firestore", "MongoDB"] },
    { area: "skills.categories.cloud", tools: ["AWS EC2", "S3", "Google Cloud VMs", "Cloudflare", "Linux and SSH", "WordPress", "WooCommerce"] },
    { area: "skills.categories.ai", tools: ["OpenAI and LLM APIs", "Claude Code", "Cursor"] },
    { area: "skills.categories.practice", tools: ["Git and GitHub", "Jest", "WCAG accessibility", "Technical SEO", "Core Web Vitals", "UX design"] },
];
---

<section id='skills' class='section'>
    <div class='shell'>
        <header class='section-head'>
            <h2 class='t-h2'>{t("skills.title")}</h2>
            <p class='t-lead text-fg-2'>{t("skills.intro")}</p>
        </header>

        <table class='matrix'>
            <thead class='sr-only'>
                <tr>
                    <th scope='col'>{t("skills.area")}</th>
                    <th scope='col'>{t("skills.tools")}</th>
                </tr>
            </thead>
            <tbody>
                {rows.map((r) => (
                    <tr>
                        <th scope='row'>{t(r.area)}</th>
                        <td>
                            <ul>
                                {r.tools.map((tool) => <li>{tool}</li>)}
                            </ul>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</section>

<style>
    .matrix {
        width: 100%;
        border-collapse: collapse;
        border-top: 1px solid rgb(var(--fg));
    }
    .matrix tr { border-bottom: 1px solid rgb(var(--rule)); }
    .matrix th[scope="row"],
    .matrix td {
        display: block;
        text-align: left;
        vertical-align: top;
    }
    .matrix th[scope="row"] {
        padding-top: 20px;
        font-weight: 700;
    }
    .matrix td { padding: 8px 0 20px; }
    @media (min-width: 768px) {
        .matrix th[scope="row"],
        .matrix td { display: table-cell; padding-block: 22px; }
        .matrix th[scope="row"] { width: 25%; padding-right: 32px; }
    }
    .matrix ul {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .matrix li {
        padding: 6px 12px;
        background: rgb(var(--surface));
        border: 1px solid rgb(var(--rule));
        font-size: 0.95rem;
        line-height: 1.3;
    }
</style>
