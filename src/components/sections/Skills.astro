---
import { useTranslations } from "@/i18n/utils";
import type { TranslationKey } from "@/i18n/types";

const { lang } = Astro.params;
const currentLang = (lang as "en" | "es") || "en";
const t = useTranslations(currentLang);

interface SkillCard {
  skill: string;
  icon: string;
  description: TranslationKey;
}

const coreSkills: SkillCard[] = [
  { skill: "React", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg", description: "skills.royalFlush.react" },
  { skill: "Node.js", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg", description: "skills.royalFlush.node" },
  { skill: "TypeScript", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg", description: "skills.royalFlush.typescript" },
  { skill: "PostgreSQL", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg", description: "skills.royalFlush.postgres" },
  { skill: "React Native", icon: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg", description: "skills.royalFlush.reactNative" },
];

const skillCategories = [
  {
    label: t("skills.categories.frontend"),
    skills: ["JavaScript/TypeScript", "HTML & CSS", "TailwindCSS"],
  },
  {
    label: t("skills.categories.backend"),
    skills: ["Python", "Django", "REST API"],
  },
  {
    label: t("skills.categories.database"),
    skills: ["MongoDB"],
  },
  {
    label: t("skills.categories.cloud"),
    skills: ["AWS (EC2, S3)", "Firebase/Firestore"],
  },
  {
    label: t("skills.categories.tools"),
    skills: ["Git/GitHub", "Testing (Jest)"],
  },
  {
    label: t("skills.categories.design"),
    skills: ["UX/UI"],
  },
];
---

<section
  id='skills'
  class='py-section min-h-screen relative'
>
  <div class='max-w-content mx-auto px-6 md:px-12'>
    <h2 class='font-heading text-4xl md:text-5xl font-bold text-text-primary text-center mb-16 skill-reveal'>
      {t("skills.title")}<span class='text-accent'>.</span>
    </h2>

    <!-- Core Skills Cards -->
    <div class='flex justify-center gap-4 md:gap-6 flex-wrap mb-20 royal-flush-row'>
      {
        coreSkills.map((card, idx) => (
          <div
            class='poker-card flop-card'
            style={`--delay: ${idx * 0.15}s`}
          >
            <img src={card.icon} alt={card.skill} class='w-10 h-10 mb-4 opacity-80' loading='lazy' />
            <div class='relative z-10'>
              <h3 class='text-lg font-bold text-text-primary font-heading mb-2'>
                {card.skill}
              </h3>
              <p class='text-sm text-text-secondary leading-relaxed'>
                {t(card.description)}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Other Skills -->
    <div class='grid sm:grid-cols-2 lg:grid-cols-3 gap-6'>
      {
        skillCategories.map((cat) => (
          <div class='skill-category skill-reveal'>
            <h4 class='text-accent font-mono text-xs uppercase tracking-widest mb-3'>
              {cat.label}
            </h4>
            <div class='flex flex-wrap gap-2'>
              {cat.skills.map((skill) => (
                <span class='skill-tag'>{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .poker-card {
    position: relative;
    width: 10rem;
    min-height: 15rem;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(10, 22, 40, 0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(46, 139, 255, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .poker-card:hover {
    border-color: rgba(46, 139, 255, 0.35);
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(46, 139, 255, 0.12);
  }

  .flop-card {
    opacity: 0;
    transform: translateX(-40px) rotateY(60deg);
  }

  .flop-animate .flop-card {
    animation: flop-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--delay);
  }

  @keyframes flop-in {
    0% {
      opacity: 0;
      transform: translateX(-40px) rotateY(60deg);
    }
    100% {
      opacity: 1;
      transform: translateX(0) rotateY(0deg);
    }
  }

  .flopped {
    opacity: 1 !important;
    transform: translateX(0) rotateY(0deg) !important;
  }

  .skill-category {
    padding: 1.25rem;
    background: rgba(10, 22, 40, 0.4);
    border: 1px solid rgba(46, 139, 255, 0.06);
    border-radius: 0.75rem;
    transition: border-color 0.3s ease;
  }

  .skill-category:hover {
    border-color: rgba(46, 139, 255, 0.15);
  }

  .skill-tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-family: "JetBrains Mono", monospace;
    color: #8B9AB8;
    background: rgba(15, 31, 54, 0.6);
    border: 1px solid rgba(46, 139, 255, 0.08);
    border-radius: 2rem;
    transition: all 0.2s ease;
  }

  .skill-tag:hover {
    color: #2E8BFF;
    border-color: rgba(46, 139, 255, 0.25);
  }

  .skill-reveal {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    filter: blur(4px);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== "undefined") {
    const section = document.querySelector("#skills .royal-flush-row");
    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add("flop-animate");
              const cards = section.querySelectorAll(".poker-card");
              cards.forEach((card) => {
                card.addEventListener(
                  "animationend",
                  () => {
                    card.classList.add("flopped");
                    card.classList.remove("flop-card");
                  },
                  { once: true },
                );
              });
              observer.disconnect();
            }
          });
        },
        { threshold: 0.3 },
      );
      observer.observe(section);
    }

    gsap.to(".skill-reveal", {
      scrollTrigger: {
        trigger: "#skills",
        start: "top 65%",
      },
      opacity: 1,
      y: 0,
      scale: 1,
      filter: "blur(0px)",
      duration: 0.8,
      stagger: 0.1,
      ease: "power3.out",
    });
  }
</script>
