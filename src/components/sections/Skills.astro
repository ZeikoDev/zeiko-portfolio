---
import { useTranslations } from "@/i18n/utils";
import type { TranslationKey } from "@/i18n/types";

const { lang } = Astro.params;
const currentLang = (lang as "en" | "es") || "en";
const t = useTranslations(currentLang);

interface SkillCard {
  skill: string;
  icon: string;
  description: TranslationKey;
}

const coreSkills: SkillCard[] = [
  { skill: "React", icon: "/assets/icons/react.svg", description: "skills.core.react" },
  { skill: "TypeScript", icon: "/assets/icons/typescript.svg", description: "skills.core.typescript" },
  { skill: "Node.js", icon: "/assets/icons/nodejs.svg", description: "skills.core.node" },
  { skill: "PostgreSQL", icon: "/assets/icons/postgresql.svg", description: "skills.core.postgres" },
  { skill: "React Native", icon: "/assets/icons/react.svg", description: "skills.core.reactNative" },
];

const skillCategories = [
  {
    label: t("skills.categories.frontend"),
    skills: ["JavaScript/TypeScript", "HTML & CSS", "TailwindCSS", "Astro"],
  },
  {
    label: t("skills.categories.backend"),
    skills: ["Python", "Django", "REST API"],
  },
  {
    label: t("skills.categories.database"),
    skills: ["MongoDB"],
  },
  {
    label: t("skills.categories.cloud"),
    skills: ["AWS (EC2, S3)", "Firebase/Firestore"],
  },
  {
    label: t("skills.categories.tools"),
    skills: ["Git/GitHub", "Testing (Jest)"],
  },
  {
    label: t("skills.categories.design"),
    skills: ["UX/UI"],
  },
];
---

<section
  id='skills'
  class='py-section relative'
>
  <div class='max-w-content mx-auto px-6 md:px-12'>
    <h2 class='section-title font-heading font-bold text-text-primary text-center mb-16' data-reveal>
      {t("skills.title")}<span class='text-accent'>.</span>
    </h2>

    <!-- Core Skills Cards -->
    <div class='flex justify-center gap-4 md:gap-6 flex-wrap mb-20'>
      {
        coreSkills.map((card, idx) => (
          <div
            class='skill-card glow-card'
            data-reveal
            style={`--reveal-delay: ${idx * 0.1}s`}
          >
            <img src={card.icon} alt='' width='40' height='40' class='w-10 h-10 mb-4 opacity-80' loading='lazy' aria-hidden='true' />
            <div class='relative z-10'>
              <h3 class='text-lg font-bold text-text-primary font-heading mb-2'>
                {card.skill}
              </h3>
              <p class='text-sm text-text-secondary leading-relaxed'>
                {t(card.description)}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Other Skills -->
    <div class='grid sm:grid-cols-2 lg:grid-cols-3 gap-6'>
      {
        skillCategories.map((cat, idx) => (
          <div class='skill-category glow-card' data-reveal style={`--reveal-delay: ${idx * 0.06}s`}>
            <h4 class='text-accent font-mono text-xs uppercase tracking-widest mb-3'>
              {cat.label}
            </h4>
            <div class='flex flex-wrap gap-2'>
              {cat.skills.map((skill) => (
                <span class='skill-tag'>{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-card {
    position: relative;
    width: 10rem;
    min-height: 13rem;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(10, 22, 40, 0.7);
    border: 1px solid rgba(46, 139, 255, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .skill-card:hover {
    border-color: rgba(46, 139, 255, 0.35);
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(46, 139, 255, 0.12);
  }

  .skill-category {
    padding: 1.25rem;
    background: rgba(10, 22, 40, 0.4);
    border: 1px solid rgba(46, 139, 255, 0.06);
    border-radius: 0.75rem;
    transition: border-color 0.3s ease;
  }

  .skill-category:hover {
    border-color: rgba(46, 139, 255, 0.15);
  }

  .skill-tag {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-family: "JetBrains Mono", monospace;
    color: #8B9AB8;
    background: rgba(15, 31, 54, 0.6);
    border: 1px solid rgba(46, 139, 255, 0.08);
    border-radius: 2rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .skill-tag:hover {
    color: #2E8BFF;
    border-color: rgba(46, 139, 255, 0.25);
  }
</style>
