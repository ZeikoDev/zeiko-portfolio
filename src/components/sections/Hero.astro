---
import { useTranslations, getLangFromUrl, languages } from "@/i18n/utils";

const { lang } = Astro.params;
const currentLang = (lang as "en" | "es") || "en";
const t = useTranslations(currentLang);
const base = import.meta.env.BASE_URL;
---

<section
    id='hero'
    class='min-h-screen flex items-center relative overflow-hidden'
>
    <!-- Language Switch -->
    <div class='absolute top-8 right-8 z-20'>
        <button
            id='language-switch'
            class='language-switch-btn'
            aria-label={t("common.switchLanguage")}
        >
            <div class='switch-track'>
                <div class='switch-thumb'>
                    <span class='lang-text lang-en'>EN</span>
                    <span class='lang-text lang-es'>ES</span>
                </div>
            </div>
        </button>
    </div>

    <!-- Background -->
    <div class='absolute inset-0 bg-navy-950'>
        <div class='dot-grid absolute inset-0 opacity-[0.04]'></div>
        <div class='absolute inset-0 bg-gradient-to-br from-accent/5 via-transparent to-transparent'></div>
        <div class='absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-navy-950 to-transparent'></div>
    </div>

    <!-- Floating BJJ Belt -->
    <div class='absolute right-[10%] top-1/2 -translate-y-1/2 opacity-[0.07] pointer-events-none hidden lg:block'>
        <img
            src={`${base}bjj-belt.svg`}
            alt=''
            class='w-[400px] h-[400px] animate-float'
            aria-hidden='true'
        />
    </div>

    <!-- Content -->
    <div class='relative z-10 max-w-content mx-auto px-6 md:px-12 w-full'>
        <div class='max-w-3xl'>
            <div class='mb-4'>
                <span class='inline-block text-accent font-mono text-sm tracking-widest uppercase opacity-0' data-hero-reveal>
                    {t("hero.subtitle")}
                </span>
            </div>

            <h1 class='hero-title font-heading font-800 text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[0.95] tracking-tight mb-8'>
                <span class='block overflow-hidden'>
                    <span class='hero-line inline-block opacity-0'>ZeikoDev.</span>
                </span>
                <span class='block overflow-hidden mt-2'>
                    <span class='hero-line inline-block opacity-0 text-accent'>Camilo</span>
                </span>
                <span class='block overflow-hidden mt-2'>
                    <span class='hero-line inline-block opacity-0 text-accent'>Gonzalez.</span>
                </span>
            </h1>

            <p class='text-lg md:text-xl text-text-secondary max-w-xl leading-relaxed mb-12 opacity-0' data-hero-reveal>
                {t("hero.description")}
            </p>

            <!-- Scroll Indicator -->
            <div class='flex items-center gap-3 opacity-0' data-hero-reveal>
                <div class='w-px h-12 bg-accent/30 animate-glow-pulse'></div>
                <a
                    href='#about'
                    class='text-text-muted text-sm font-mono uppercase tracking-wider hover:text-accent transition-colors duration-300'
                    aria-label={t("nav.about")}
                >
                    scroll
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .dot-grid {
        background-image: radial-gradient(circle, #2E8BFF 1px, transparent 1px);
        background-size: 32px 32px;
    }

    .hero-title {
        line-height: 0.95;
    }

    /* Language Switch */
    .language-switch-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        outline: none;
        transition: transform 0.2s ease;
    }

    .language-switch-btn:hover {
        transform: scale(1.05);
    }

    .language-switch-btn:active {
        transform: scale(0.95);
    }

    .switch-track {
        position: relative;
        width: 72px;
        height: 36px;
        background: rgba(15, 31, 54, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(46, 139, 255, 0.15);
        border-radius: 18px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .switch-thumb {
        position: absolute;
        top: 2px;
        left: 2px;
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #2E8BFF 0%, #1E6FD9 100%);
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(46, 139, 255, 0.3);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .lang-text {
        position: absolute;
        font-size: 11px;
        font-weight: 700;
        font-family: "JetBrains Mono", monospace;
        color: white;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0;
        transform: scale(0.8);
    }

    .lang-text.lang-en {
        left: 50%;
        transform: translateX(-50%) scale(0.8);
    }

    .lang-text.lang-es {
        right: 50%;
        transform: translateX(50%) scale(0.8);
    }

    .language-switch-btn[data-lang="en"] .switch-thumb {
        left: 2px;
    }

    .language-switch-btn[data-lang="en"] .lang-text.lang-en {
        opacity: 1;
        transform: translateX(-50%) scale(1);
    }

    .language-switch-btn[data-lang="es"] .switch-thumb {
        left: 38px;
    }

    .language-switch-btn[data-lang="es"] .lang-text.lang-es {
        opacity: 1;
        transform: translateX(50%) scale(1);
    }

    .language-switch-btn:hover .switch-track {
        border-color: rgba(46, 139, 255, 0.3);
    }
</style>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".hero-line").forEach((el) => {
            gsap.set(el, { y: 80, opacity: 0, rotateX: 40 });
        });
        gsap.set("[data-hero-reveal]", { y: 30, opacity: 0 });

        const tl = gsap.timeline({ delay: 0.4 });

        tl.to(".hero-line", {
            opacity: 1,
            y: 0,
            rotateX: 0,
            duration: 1.1,
            stagger: 0.2,
            ease: "power4.out",
        });

        tl.to(
            "[data-hero-reveal]",
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: "power3.out",
            },
            "-=0.5",
        );
    });

    // Language Switch
    document.addEventListener("DOMContentLoaded", () => {
        const languageSwitch = document.getElementById(
            "language-switch",
        ) as HTMLButtonElement;
        if (!languageSwitch) return;

        const currentLang = window.location.pathname.startsWith("/es")
            ? "es"
            : "en";

        languageSwitch.setAttribute("data-lang", currentLang);

        languageSwitch.addEventListener("click", () => {
            const currentLang = languageSwitch.getAttribute("data-lang");
            const newLang = currentLang === "en" ? "es" : "en";

            languageSwitch.setAttribute("data-lang", newLang);

            const currentPath = window.location.pathname;
            const newPath = currentPath.replace(/^\/(en|es)/, `/${newLang}`);

            setTimeout(() => {
                window.location.href = newPath;
            }, 150);
        });
    });
</script>
