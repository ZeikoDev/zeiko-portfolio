---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { useTranslations } from "@/i18n/utils";
import { SITE } from "@/data/site";

const { lang } = Astro.params;
const t = useTranslations((lang as "en" | "es") || "en");

const facts = [
    { term: t("hero.facts.location"), value: t("hero.facts.locationValue") },
    { term: t("hero.facts.experience"), value: t("hero.facts.experienceValue") },
    { term: t("hero.facts.users"), value: t("hero.facts.usersValue") },
    { term: t("hero.facts.languages"), value: t("hero.facts.languagesValue") },
];
---

<section id='top' class='hero'>
    <div class='shell'>
        <div class='hero-grid'>
            <div class='hero-copy'>
                <p class='hero-role hero-in' style='--d:0s'>{t("hero.role")}</p>
                <h1 class='t-display hero-in' style='--d:0.08s'>{t("hero.headline")}</h1>
                <p class='t-lead hero-summary hero-in' style='--d:0.16s'>{t("hero.summary")}</p>

                <div class='hero-ctas hero-in' style='--d:0.24s'>
                    <Button href={`mailto:${SITE.email}`} variant='primary'>
                        <Icon name='mail' />
                        {t("hero.ctaContact")}
                    </Button>
                    <Button href={SITE.linkedin} variant='secondary' external>
                        <Icon name='linkedin' />
                        LinkedIn
                    </Button>
                    <Button href={SITE.github} variant='secondary' external>
                        <Icon name='github' />
                        GitHub
                    </Button>
                </div>
                <p class='hero-availability t-small hero-in' style='--d:0.3s'>{t("hero.availability")}</p>
            </div>

            <figure class='hero-figure hero-in' style='--d:0.12s'>
                <img
                    src='/assets/camilo-gonzalez.webp'
                    alt={t("hero.photoAlt")}
                    width='880'
                    height='1100'
                    fetchpriority='high'
                />
            </figure>
        </div>
    </div>

    <div class='shell'>
    <dl class='facts'>
        {facts.map((f) => (
            <div class='fact'>
                <dt class='t-small'>{f.term}</dt>
                <dd>{f.value}</dd>
            </div>
        ))}
    </dl>
    </div>
</section>

<style>
    .hero {
        padding-top: 64px;
    }
    @media (min-width: 1024px) {
        .hero { padding-top: 104px; }
    }

    .hero-grid {
        display: grid;
        gap: 56px;
        padding-bottom: 64px;
    }
    @media (min-width: 1024px) {
        .hero-grid {
            grid-template-columns: repeat(12, minmax(0, 1fr));
            column-gap: 32px;
            align-items: end;
            padding-bottom: 104px;
        }
        .hero-copy { grid-column: 1 / span 7; }
        .hero-figure { grid-column: 9 / span 4; }
    }

    .hero-figure {
        max-width: 420px;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: rgb(var(--surface));
    }
    @media (min-width: 1024px) {
        .hero-figure { max-width: none; align-self: start; }
    }
    .hero-figure img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-role {
        font-weight: 600;
        color: rgb(var(--blue));
        margin-bottom: 24px;
    }
    .hero-summary {
        margin-top: 28px;
        max-width: 56ch;
        color: rgb(var(--fg-2));
    }
    .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 40px;
    }
    .hero-availability {
        margin-top: 20px;
        color: rgb(var(--fg-2));
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid rgb(var(--rule));
    }
    @media (min-width: 1024px) {
        .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    }
    .fact {
        padding: 20px 16px 28px 0;
        border-bottom: 1px solid rgb(var(--rule));
    }
    .fact + .fact {
        padding-left: 16px;
        border-left: 1px solid rgb(var(--rule));
    }
    @media (max-width: 1023px) {
        .fact + .fact:nth-child(3) { padding-left: 0; border-left: 0; }
    }
    @media (min-width: 1024px) {
        .fact { border-bottom: 0; }
        .fact + .fact { padding-left: 24px; }
    }
    .fact dt { color: rgb(var(--fg-2)); margin-bottom: 6px; }
    .fact dd { font-weight: 600; font-size: 1.05rem; line-height: 1.35; }

    @media (prefers-reduced-motion: no-preference) {
        .hero-in {
            animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
            animation-delay: var(--d);
        }
    }
    @keyframes rise {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: none; }
    }
</style>
