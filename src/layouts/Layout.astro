---
import "@/styles/tokens.css";
import Icon from "@/components/ui/Icon.astro";
import { useTranslations } from "@/i18n/utils";
import { SITE } from "@/data/site";

interface Props {
	title?: string;
	description?: string;
}

const { lang } = Astro.params;
const currentLang = (lang as "en" | "es") || "en";
const t = useTranslations(currentLang);
const { title = t("meta.title"), description = t("meta.description") } = Astro.props;

const otherLang = currentLang === "en" ? "es" : "en";
const altPath = Astro.url.pathname.replace(/^\/(en|es)(?=\/|$)/, `/${otherLang}`);
const home = `/${currentLang}`;

const navItems = [
	{ href: `${home}#experience`, label: t("nav.experience") },
	{ href: `${home}#work`, label: t("nav.projects") },
	{ href: `${home}#skills`, label: t("nav.skills") },
	{ href: `${home}#labs`, label: t("nav.labs") },
	{ href: `${home}#contact`, label: t("nav.contact") },
];
---

<!doctype html>
<html lang={currentLang} class='dark'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<meta name='description' content={description} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:type' content='website' />
		<meta name='theme-color' content='#161616' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='alternate' hreflang={otherLang} href={altPath} />
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			href='https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&display=swap'
			rel='stylesheet'
		/>
		<title>{title}</title>
		<script is:inline>
			// Dark is the default; a saved choice wins. Runs before paint.
			(function () {
				var theme = "dark";
				try {
					theme = localStorage.getItem("theme") || "dark";
				} catch (e) {}
				document.documentElement.classList.toggle("dark", theme === "dark");
			})();
		</script>
	</head>
	<body class='min-h-screen'>
		<a href='#main' class='skip-link'>{t("nav.skip")}</a>

		<header class='site-header'>
			<div class='shell header-row'>
				<a href={home} class='brand'>{SITE.name}</a>

				<nav aria-label={t("nav.label")} class='header-nav'>
					<ul>
						{navItems.map((item) => (
							<li><a href={item.href}>{item.label}</a></li>
						))}
					</ul>
				</nav>

				<div class='header-tools'>
					<a href={altPath} class='tool-btn' hreflang={otherLang} lang={otherLang} aria-label={t("common.switchLanguage")}>
						{t("common.switchLanguageShort")}
					</a>
					<button type='button' class='tool-btn' id='theme-toggle' aria-label={t("common.theme")}>
						<Icon name='sun' class='icon-sun w-[18px] h-[18px]' />
						<Icon name='moon' class='icon-moon w-[18px] h-[18px]' />
					</button>
				</div>
			</div>
		</header>

		<main id='main'>
			<slot />
		</main>

		<footer class='site-footer'>
			<div class='shell footer-row t-small'>
				<p>&copy; {new Date().getFullYear()} {SITE.fullName}</p>
				<ul class='footer-links'>
					<li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
					<li><a href={SITE.linkedin} target='_blank' rel='noopener noreferrer'>LinkedIn</a></li>
					<li><a href={SITE.github} target='_blank' rel='noopener noreferrer'>GitHub</a></li>
				</ul>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	.skip-link {
		position: absolute;
		left: var(--gutter);
		top: -100px;
		z-index: 100;
		padding: 0.75rem 1rem;
		background: rgb(var(--blue-block));
		color: #fff;
	}
	.skip-link:focus { top: 8px; }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: rgb(var(--bg) / 0.92);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgb(var(--rule));
	}

	.header-row {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 64px;
	}

	.brand {
		font-weight: 700;
		font-size: 1rem;
		font-variation-settings: "wdth" 108;
		letter-spacing: -0.01em;
		white-space: nowrap;
		flex: none;
	}

	.header-nav {
		flex: 1;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.header-nav::-webkit-scrollbar { display: none; }
	.header-nav ul {
		display: flex;
		gap: 4px;
	}
	.header-nav a {
		display: block;
		padding: 0.5rem 0.75rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: rgb(var(--fg-2));
		white-space: nowrap;
		border-bottom: 2px solid transparent;
	}
	.header-nav a:hover { color: rgb(var(--fg)); }
	.header-nav a[aria-current="true"] {
		color: rgb(var(--fg));
		border-bottom-color: rgb(var(--blue));
	}

	.header-tools {
		display: flex;
		gap: 8px;
		flex: none;
	}
	.tool-btn {
		display: grid;
		place-items: center;
		min-width: 40px;
		height: 40px;
		padding: 0 0.5rem;
		border: 1px solid rgb(var(--rule));
		font-size: 0.85rem;
		font-weight: 600;
		color: rgb(var(--fg));
		background: transparent;
		cursor: pointer;
	}
	.tool-btn:hover { border-color: rgb(var(--fg-2)); }
	.icon-moon { display: none; }
	:root:not(.dark) .icon-sun { display: none; }
	:root:not(.dark) .icon-moon { display: block; }

	@media (max-width: 767px) {
		.header-row {
			flex-wrap: wrap;
			height: auto;
			padding-block: 12px 0;
			row-gap: 4px;
		}
		.header-tools { margin-left: auto; }
		.header-nav {
			order: 3;
			flex-basis: 100%;
			margin-inline: calc(var(--gutter) * -1);
			padding-inline: calc(var(--gutter) - 0.75rem);
		}
		html { scroll-padding-top: 120px; }
	}

	.site-footer {
		border-top: 1px solid rgb(var(--rule));
		padding-block: 32px;
		color: rgb(var(--fg-2));
	}
	.footer-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 16px;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
	}
	.footer-links a:hover { color: rgb(var(--fg)); text-decoration: underline; }
</style>

<script>
	const toggle = document.getElementById("theme-toggle");
	toggle?.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		try {
			localStorage.setItem("theme", dark ? "dark" : "light");
		} catch {}
	});

	// Highlight the nav item for the section in view (home page only).
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".header-nav a"));
	const sections = links
		.map((a) => document.getElementById(a.hash.slice(1)))
		.filter((el): el is HTMLElement => !!el);
	const top = document.getElementById("top");
	if (top) sections.push(top);

	if (sections.length && "IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					links.forEach((a) =>
						a.setAttribute("aria-current", String(a.hash === `#${entry.target.id}`)),
					);
				}
			},
			{ rootMargin: "-45% 0px -50% 0px" },
		);
		sections.forEach((s) => io.observe(s));
	}
</script>
